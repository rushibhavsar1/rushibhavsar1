# ─────────────────────────────────────────────────────────────────────────────
# DeskPilot environment variables. Copy to `.env.local` for development.
# Everything without the NEXT_PUBLIC_ prefix is server-only and must never be
# exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the web app (used in emails, widget snippet, webhooks).
APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL + anon/publishable key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct Postgres connection (session mode, port 5432) used by the server,
# the worker and pg-boss. Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require
# Max connections per process (web and worker each open their own pool).
DATABASE_POOL_MAX=10

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Resend (outgoing email) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Sender for platform emails (weekly reports). Must be on a domain verified in
# YOUR Resend account, e.g. "DeskPilot <reports@mail.yourdomain.com>".
SYSTEM_FROM_EMAIL=

# ── Telegram (owner approvals on mobile) ────────────────────────────────────
# Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string (A-Z, a-z, 0-9, _ and -, 1-256 chars). Telegram sends it back in
# the X-Telegram-Bot-Api-Secret-Token header so we can verify webhook requests.
TELEGRAM_WEBHOOK_SECRET=

# ── Stripe (billing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Price IDs for the three plans.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...
# Free trial length for new subscriptions (0 to disable).
STRIPE_TRIAL_DAYS=14

# ── Cal.com ─────────────────────────────────────────────────────────────────
# No global key needed: each business gets its own webhook URL and signing
# secret on the Settings -> Integrations page.

# ── Networking ──────────────────────────────────────────────────────────────
# Reverse proxies in front of the app that append to X-Forwarded-For. Coolify's
# Traefik = 1. Add 1 for a CDN such as Cloudflare in front of it.
TRUSTED_PROXY_HOPS=1

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
# The weekly report goes out on Monday at this hour in each business's own time zone.
WEEKLY_REPORT_HOUR=8

# ── Logging ─────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
